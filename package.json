{
  "name": "solana-lab",
  "private": true,
  "packageManager": "bun@1.3.2",
  "workspaces": [
    "packages/*",
    "programs/*/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "clean": "turbo run clean",
    "new": "bash scripts/new-program.sh"
  },
  "devDependencies": {
    "turbo": "^2",
    "husky": "^9",
    "lint-staged": "^17.1.0",
    "@biomejs/biome": "^2.5.5",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "bun-types": "latest",
    "@types/node": "^26.1.1"
  },
  "lint-staged": {
    "*.{ts,tsx,js,json}": [
      "biome check --write --no-errors-on-unmatched"
    ],
    "*.rs": [
      "rustfmt --edition 2021"
    ]
  }
}
